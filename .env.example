# Public HTTPS origin used for OAuth callbacks and social metadata.
PUBLIC_APP_URL=https://app.your-domain.vn

# Generate independent high-entropy values in the deployment secret manager.
OAUTH_STATE_SECRET=replace-with-a-random-secret
INTEGRATION_TOKEN_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key
INTERNAL_API_SECRET=replace-with-a-random-internal-api-secret
# Shared only between the trusted reverse proxy and the app. Never send it to browsers.
TRUSTED_PROXY_SECRET=replace-with-a-random-trusted-proxy-secret
# Comma-separated exact oai-authenticated-user-id values allowed to operate the Site.
SITES_OPERATOR_USER_IDS=
SITES_OPERATOR_EMAILS=
SITES_VIEWER_USER_IDS=
SITES_VIEWER_EMAILS=

# Google Drive + Google Sheets
GOOGLE_AUTH_MODE=oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.your-domain.vn/api/integrations/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/spreadsheets.readonly
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Products
GOOGLE_SHEET_RANGE=Products!A:Z

# Facebook Page
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0
META_REDIRECT_URI=https://app.your-domain.vn/api/integrations/facebook/callback

# Shopee Open Platform — Vietnam live app
SHOPEE_ENV=production
SHOPEE_REGION=VN
SHOPEE_BASE_URL=https://partner.shopeemobile.com
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=https://app.your-domain.vn/api/integrations/shopee/callback

# TikTok Shop Partner Center — Vietnam
TIKTOK_SHOP_MARKET=VN
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_REDIRECT_URI=https://app.your-domain.vn/api/integrations/tiktok-shop/callback
TIKTOK_SHOP_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_AUTH_BASE_URL=https://auth.tiktok-shops.com
TIKTOK_SHOP_AUTHORIZE_URL=https://services.tiktokshop.com/open/authorize

# Zalo personal remains human-confirmed; no cookie/QR/private API credentials.
ZALO_PERSONAL_MODE=manual_assist

# Existing commerce website receiving signed JSON payloads from TAHA AI.
WEBSITE_BASE_URL=https://shop.your-domain.vn
WEBSITE_PUBLISH_ENDPOINT=https://shop.your-domain.vn/api/taha/publish
WEBSITE_WEBHOOK_SECRET=

# OpenAI — keep OPENAI_API_KEY in the server secret manager, never commit it.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
